# 视频创作平台环境配置文件示例
# 复制此文件为 .env 并填入你的实际API密钥

# ===========================================
# 应用基础配置
# ===========================================
APP_NAME="Video Creator Platform"
VERSION="0.1.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# ===========================================
# LLM API密钥配置
# ===========================================
# OpenAI API密钥 (用于GPT模型和DALL-E)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Anthropic API密钥 (用于Claude模型)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Google API密钥 (用于Gemini模型)
GOOGLE_API_KEY="your-google-api-key-here"

# ===========================================
# 音频处理API密钥
# ===========================================
# ElevenLabs API密钥 (用于高质量TTS)
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"

# ===========================================
# 图像生成API密钥
# ===========================================
# DALL-E使用OpenAI API密钥
DALLE_API_KEY="${OPENAI_API_KEY}"

# Stability AI API密钥
STABILITY_API_KEY="your-stability-api-key-here"

# Replicate API密钥
REPLICATE_API_KEY="your-replicate-api-key-here"

# Leonardo AI API密钥
LEONARDO_API_KEY="your-leonardo-api-key-here"

# ===========================================
# 视频生成API密钥
# ===========================================
# Runway ML API密钥 (用于视频生成)
RUNWAY_API_KEY="your-runway-api-key-here"

# Luma Dream Machine API密钥
LUMA_API_KEY="your-luma-api-key-here"

# Pika Labs API密钥
PIKA_API_KEY="your-pika-api-key-here"

# Kling AI API密钥
KLING_API_KEY="your-kling-api-key-here"

# Google Gemini API密钥
GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key-here"

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL="sqlite:///./video_creator.db"

# ===========================================
# 文件存储配置
# ===========================================
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
MAX_FILE_SIZE=104857600  # 100MB in bytes

# ===========================================
# LLM模型配置
# ===========================================
MAX_TOKENS=4000
TEMPERATURE=0.7

# ===========================================
# 视频处理配置
# ===========================================
MAX_VIDEO_DURATION=300  # 5分钟
VIDEO_QUALITY="medium"
FPS=30

# ===========================================
# 图像生成配置
# ===========================================
DEFAULT_IMAGE_PROVIDER="dalle"  # dalle, stability, replicate, leonardo
IMAGE_SIZE="512,512"

# DALL-E配置
DALLE_MODEL="dall-e-3"
DALLE_QUALITY="standard"  # standard, hd
DALLE_STYLE="vivid"  # vivid, natural

# Stability AI配置
STABILITY_MODEL="stable-diffusion-xl-1024-v1-0"

# ===========================================
# 前端配置
# ===========================================
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"

# ===========================================
# 安全配置
# ===========================================
SECRET_KEY="your-secret-key-here-change-in-production"
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# ===========================================
# 缓存配置
# ===========================================
CACHE_ENABLED=true
CACHE_TTL=3600
